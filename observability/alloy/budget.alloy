// Your series budget (S5, decision 014). Every series from this host passes through one of these three
// before it's sent. Grafana Cloud's free tier allows 10,000 active series for all hosts together
// (contracts/metrics.yaml). With no rules, everything is sent.
//
// Rules are Prometheus relabelling (https://grafana.com/docs/alloy/latest/reference/components/prometheus/prometheus.relabel/):
//   rule { source_labels = ["__name__"]  regex = "node_(cpu|memory)_.*"  action = "keep" }
//   rule { regex = "id"  action = "labeldrop" }

declare "host" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Option B (decision 014): CPU idle, memory total and available, and the root filesystem. No
		// network, no per-device disk, no node_exporter bookkeeping.
		rule {
			source_labels = ["__name__"]
			regex         = "up|node_cpu_seconds_total|node_memory_MemTotal_bytes|node_memory_MemAvailable_bytes|node_filesystem_(avail|size)_bytes"
			action        = "keep"
		}

		// Only the idle mode of CPU time; the others add up to 1 minus idle.
		rule {
			source_labels = ["__name__", "mode"]
			regex         = "node_cpu_seconds_total;(?:iowait|irq|nice|softirq|steal|system|user)"
			action        = "drop"
		}

		// Only the root filesystem (mountpoint "/"): any other mountpoint, longer than one character, is dropped.
		rule {
			source_labels = ["__name__", "mountpoint"]
			regex         = "node_filesystem_.+;(.{2,}|[^/])"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "containers" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Option B (decision 014): CPU, working-set memory and last-seen per container. No disk, network
		// or spec series.
		rule {
			source_labels = ["__name__"]
			regex         = "up|container_cpu_usage_seconds_total|container_memory_working_set_bytes|container_last_seen"
			action        = "keep"
		}

		// Labels that change on every deploy (cgroup id, image tag = commit SHA, Compose's config hash and
		// replace labels): dropped, so a redeploy continues the same series. "name" still tells containers apart.
		rule {
			regex  = "id|image|container_label_.*"
			action = "labeldrop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "services" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Option B (decision 014): everything in contracts/metrics.yaml and Traefik's per-service series
		// stay. Dropped: Traefik's entrypoint series, and the runtime metrics (process_*, python_*) and
		// scrape_* bookkeeping that nothing reads.
		rule {
			source_labels = ["__name__"]
			regex         = "traefik_entrypoint_.*|process_.*|python_.*|scrape_.*"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}
